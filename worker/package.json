{
  "name": "hamvara-growth-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/mrp.js && npm test",
    "check:performance": "node scripts/check-mrp-performance.mjs",
    "check:storage-stress": "node scripts/check-mrp-storage-stress.mjs",
    "test": "node --test test/*.test.mjs",
    "test:tariff-acceptance": "node --test test/tariff-review-acceptance.test.mjs",
    "dev": "wrangler dev --config ../wrangler.toml --var ALLOWED_ORIGINS:https://hamvara.com,https://www.hamvara.com,http://localhost:8080,http://127.0.0.1:8080",
    "predeploy": "node scripts/verify-deploy-config.mjs",
    "deploy": "npm run check && wrangler deploy --config ../wrangler.toml",
    "migrate:production": "wrangler d1 migrations apply hamvara-growth-production --config ../wrangler.toml --remote",
    "db:mrp": "npm run migrate:production",
    "mrp:provision": "node scripts/create-mrp-workspace.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.33.1"
  }
}

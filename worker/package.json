{
  "name": "hamvara-growth-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/mrp.js",
    "dev": "wrangler dev --config ../wrangler.toml",
    "predeploy": "node scripts/verify-deploy-config.mjs",
    "deploy": "wrangler deploy --config ../wrangler.toml",
    "db:mrp": "wrangler d1 execute hamvara-growth-production --config ../wrangler.toml --file migrations/0002_mrp_saas.sql --remote",
    "mrp:provision": "node scripts/create-mrp-workspace.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.33.1"
  }
}
